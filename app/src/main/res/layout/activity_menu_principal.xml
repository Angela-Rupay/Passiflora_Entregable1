<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="28dp"
        android:paddingBottom="32dp">

        <!-- Logo Passiflora -->
        <ImageView
            android:id="@+id/iv_logo"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/img_flor_passiflora"
            android:contentDescription="Logo Passiflora"
            android:layout_marginBottom="16dp"/>

        <!-- Nombre de la app -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Passiflora"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="@color/purple_point"
            android:layout_marginBottom="8dp"/>

        <!-- Subtítulo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tu resultado ya está listo"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:layout_marginBottom="28dp"/>

        <!-- Tarjeta del resultado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="24dp"
            android:layout_marginBottom="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Resultado GAD-7"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/green_regulator"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:id="@+id/tv_mensaje_resultado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="[Nombre], tu nivel de ansiedad evaluado según la escala GAD-7 es [Resultado]"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/deep_night"
                android:gravity="center"
                android:lineSpacingExtra="6dp"/>
        </LinearLayout>

        <!-- Tarjeta del mensaje -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="22dp"
            android:layout_marginBottom="30dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Un mensaje para ti"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/purple_primary"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:id="@+id/tv_mensaje_personalizado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mensaje personalizado de apoyo según el resultado de la escala..."
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:gravity="center"
                android:lineSpacingExtra="5dp"/>
        </LinearLayout>

        <!-- Botón Volver -->
        <Button
            android:id="@+id/btn_volver_encuesta"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginHorizontal="6dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="@color/purple_point"
            android:text="Volver a tomar encuesta"
            android:textAllCaps="false"
            android:textColor="@color/text_on_primary"
            android:textStyle="bold"/>

        <!-- Botón Respiración (mismo estilo que Volver) -->
        <Button
            android:id="@+id/btn_ejercicios_respiracion"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginHorizontal="6dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/purple_point"
            android:text="Ejercicios de respiración"
            android:textAllCaps="false"
            android:textColor="@color/text_on_primary"
            android:textStyle="bold"/>

        <!-- Botón Ejercicios (mismo estilo que Volver) -->
        <Button
            android:id="@+id/btn_ejercicios"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginHorizontal="6dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/purple_point"
            android:text="Lista de ejercicios"
            android:textAllCaps="false"
            android:textColor="@color/text_on_primary"
            android:textStyle="bold"/>

        <!-- Botón Cerrar sesión (se mantiene intacto) -->
        <Button
            android:id="@+id/btn_cerrar_sesion"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginHorizontal="6dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/error"
            android:text="Cerrar sesión"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textStyle="bold"/>

    </LinearLayout>

</ScrollView>